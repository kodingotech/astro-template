---
import { SITE } from '@/config/site';
import type { SEOProps } from '@/utils/seo';
import { generateSEO } from '@/utils/seo';

interface Props extends SEOProps {
  canonicalURL?: URL | string;
}

const { canonicalURL, ...seoProps } = Astro.props;
const seo = generateSEO(seoProps);
const canonical = canonicalURL || new URL(Astro.url.pathname, Astro.site);
---

<!-- Primary Meta Tags -->
<title>{seo.title}</title>
<meta name="title" content={seo.title} />
<meta name="description" content={seo.description} />
<link rel="canonical" href={canonical} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={seo.type} />
<meta property="og:url" content={canonical} />
<meta property="og:title" content={seo.title} />
<meta property="og:description" content={seo.description} />
<meta property="og:image" content={seo.image} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:locale" content="id_ID" />

{seo.article && (
  <>
    <meta property="article:author" content={SITE.name} />
    {seo.publishedTime && (
      <meta property="article:published_time" content={seo.publishedTime} />
    )}
    {seo.modifiedTime && (
      <meta property="article:modified_time" content={seo.modifiedTime} />
    )}
  </>
)}

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonical} />
<meta property="twitter:title" content={seo.title} />
<meta property="twitter:description" content={seo.description} />
<meta property="twitter:image" content={seo.image} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Fonts Preconnect -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />