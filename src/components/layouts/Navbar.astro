---
import { navigation } from "../../config/navigation";
import { Menu, X } from "@lucide/astro";

const currentPath = Astro.url.pathname;
---

<nav
  id="navbar"
  class="fixed top-0 left-0 right-0 z-50 bg-background/80 backdrop-blur-md border-b border-border transition-all duration-300"
>
  <div class="container-custom">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-3 group">
        <div
          class="w-10 h-10 bg-gradient-to-br from-primaryContinue10:13 AMto-accent rounded-xl flex items-center justify-center group-hover:scale-110 transition-transform"
        >
          <span class="text-white font-bold text-xl">L</span>
        </div>
        <span class="font-display font-bold text-xl text-foreground">
          Your Logo
        </span>
      </a>
      <!-- Desktop Menu -->
      <ul class="hidden md:flex items-center gap-8">
        {
          navigation.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "text-sm font-medium transition-colors focus-ring rounded-md px-3 py-2",
                  currentPath === link.href
                    ? "text-primary font-semibold"
                    : "text-foreground/80 hover:text-foreground",
                ]}
              >
                {link.name}
              </a>
            </li>
          ))
        }
      </ul>

      <!-- CTA Button (Desktop) -->
      <div class="hidden md:block">
        <a href="/contact" class="btn-primary">Get Started</a>
      </div>

      <!-- Mobile Toggle -->
      <button
        id="mobile-toggle"
        class="md:hidden p-2 text-foreground hover:text-primary transition-colors focus-ring"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <Menu class="w-6 h-6" id="menu-open" />
        <X class="w-6 h-6 hidden" id="menu-close" />
      </button>
    </div>

    <!-- Mobile Menu -->
    <div
      id="mobile-menu"
      class="hidden md:hidden pb-6 animate-slide-in-down"
      role="navigation"
    >
      <ul class="flex flex-col gap-2">
        {
          navigation.map((link) => (
            <li>
              <a
                href={link.href}
                class:list={[
                  "block px-4 py-3 rounded-lg text-sm font-medium transition-colors",
                  currentPath === link.href
                    ? "bg-primary/10 text-primary font-semibold"
                    : "text-foreground/80 hover:bg-accent/10 hover:text-foreground",
                ]}
              >
                {link.name}
              </a>
            </li>
          ))
        }
        <li class="mt-2">
          <a href="/contact" class="btn-primary w-full"> Get Started </a>
        </li>
      </ul>
    </div>
  </div>
</nav>
<!-- Spacer -->
<div class="h-20"></div>
<script>
  const toggle = document.getElementById("mobile-toggle");
  const menu = document.getElementById("mobile-menu");
  const menuOpen = document.getElementById("menu-open");
  const menuClose = document.getElementById("menu-close");
  const navbar = document.getElementById("navbar");

  // Mobile menu toggle
  toggle?.addEventListener("click", () => {
    const isOpen = menu?.classList.toggle("hidden");
    toggle?.setAttribute("aria-expanded", isOpen ? "false" : "true");
    menuOpen?.classList.toggle("hidden");
    menuClose?.classList.toggle("hidden");
  });

  // Navbar scroll effect
  let lastScroll = 0;
  window.addEventListener("scroll", () => {
    const currentScroll = window.pageYOffset;

    if (currentScroll > 100) {
      navbar?.classList.add("shadow-md");
    } else {
      navbar?.classList.remove("shadow-md");
    }

    lastScroll = currentScroll;
  });

  // Close mobile menu on route change
  document.addEventListener("astro:page-load", () => {
    menu?.classList.add("hidden");
    menuOpen?.classList.remove("hidden");
    menuClose?.classList.add("hidden");
    toggle?.setAttribute("aria-expanded", "false");
  });
</script>
