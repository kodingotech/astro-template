---
import Layout from '@/layouts/Layout.astro';
---

<Layout title="About Us - My Awesome Site">
  <section class="py-20 px-4">
    <div class="max-w-4xl mx-auto">
      <h1 class="text-5xl font-bold text-gray-900 mb-6 animate-fade-in-up">
        About Us
      </h1>
      
      <p class="text-xl text-gray-600 mb-8 animate-fade-in-up animate-delay-100">
        We're building the future of digital experiences.
      </p>
      
      <div class="prose prose-lg animate-fade-in-up animate-delay-200">
        <p class="text-gray-700 leading-relaxed">
          Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod 
          tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, 
          quis nostrud exercitation ullamco laboris.
        </p>
      </div>
    </div>
  </section>
</Layout>