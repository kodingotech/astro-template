---
import Layout from '@/layouts/Layout.astro';
import Navbar from '@/components/Navbar.astro';
import { ArrowRight } from '@lucide/astro';
---

<Layout title="Home - My Awesome Site">
  <!-- Hero Section -->
  <section class="relative min-h-screen flex items-center justify-center px-4 bg-gradient-to-br from-blue-50 to-indigo-50">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-5xl md:text-7xl font-bold text-gray-900 mb-6 animate-fade-in-up">
        Build Something
        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-600">
          Amazing
        </span>
      </h1>
      
      <p class="text-xl text-gray-600 mb-8 animate-fade-in-up animate-delay-100">
        Transform your ideas into reality with our powerful platform
      </p>
      
      <div class="flex flex-wrap gap-4 justify-center animate-fade-in-up animate-delay-200">
        <a 
          href="/about"
          class="inline-flex items-center gap-2 px-8 py-4 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-all hover:scale-105"
        >
          Get Started
          <ArrowRight class="w-5 h-5" />
        </a>
        
        <a 
          href="/about"
          class="inline-flex items-center gap-2 px-8 py-4 border-2 border-blue-600 text-blue-600 font-semibold rounded-lg hover:bg-blue-50 transition-colors"
        >
          Learn More
        </a>
      </div>
    </div>
  </section>
  
  <!-- Features Section -->
  <section class="py-20 px-4 bg-white">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Why Choose Us</h2>
        <p class="text-xl text-gray-600">Simple, powerful, and easy to use</p>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        {[
          { title: 'Fast', desc: 'Lightning fast performance' },
          { title: 'Secure', desc: 'Enterprise-grade security' },
          { title: 'Scalable', desc: 'Grows with your business' },
        ].map((feature, i) => (
          <div 
            class="p-6 bg-gray-50 rounded-xl hover:shadow-lg transition-all animate-fade-in"
            style={`animation-delay: ${i * 100}ms;`}
          >
            <h3 class="text-2xl font-bold text-gray-900 mb-2">{feature.title}</h3>
            <p class="text-gray-600">{feature.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>